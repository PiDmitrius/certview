# Stage 1: Build certget binary (static, no cgo)
FROM golang:1.24-bookworm AS go-build
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ ./internal/
COPY cmd/certget/ ./cmd/certget/
ENV CGO_ENABLED=0
RUN go test ./cmd/certget ./internal/ssrfguard ./internal/dnshost \
    && go build -o /certget ./cmd/certget

# Stage 2: Runtime with full OpenSSL + GOST engine/provider
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=gost-openssl /opt/openssl /opt/openssl
COPY --from=go-build /certget /usr/local/bin/certget
ENV PATH="/opt/openssl/bin:${PATH}"
ENV LD_LIBRARY_PATH="/opt/openssl/lib"
ENV OPENSSL_CONF="/opt/openssl/ssl/openssl.cnf"
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["certget", "-addr", ":8080"]
